@page "/posts/create"
@inject IPostService PostService

<h3>Create post</h3>

<div>
    <label>Title</label><br />
    <input @bind="title" />
</div>
<div>
    <label>Body</label><br />
    <textarea @bind="body"></textarea>
</div>
<button @onclick="HandleCreatePost">Create post</button>

@if (message is not null)
{
    <p>@message</p>
}

@code {
    private string title = "";
    private string body = "";
    private string? message;

    private async Task HandleCreatePost()
    {
        try
        {
            // UserId hardcoded til 1, som dokumentet beskriver
            PostDto created = await PostService.AddPostAsync(new CreatePostDto { Title = title, Body = body, UserId = 1 });
            message = $"Post created with Id {created.Id}";
            title = "";
            body = "";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}